{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/Tools/docs/doctool.py\" brief --refresh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/Tools/docs/doctool.py\" track",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/Tools/docs/doctool.py\" stop-check",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python Tools/docs/doctool.py *)",
      "PowerShell(python Tools/docs/doctool.py *)",
      "Bash(dotnet test Tools/Headless*)",
      "PowerShell(dotnet test Tools/Headless*)",
      "Bash(dotnet build Tools/Headless*)",
      "PowerShell(dotnet build Tools/Headless*)",
      "Bash(dotnet run --project Tools/Headless/Runner*)",
      "PowerShell(dotnet run --project Tools/Headless/Runner*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File Tools/unity.ps1*)",
      "PowerShell(powershell -ExecutionPolicy Bypass -File Tools/verify.ps1*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "PowerShell(git status*)",
      "PowerShell(git log*)",
      "PowerShell(git diff*)"
    ]
  }
}
