<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless balancing runs and doc generation for the pure C# simulation. Not part of the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Statecraft.SimRunner</AssemblyName>
    <RootNamespace>Statecraft.SimRunner</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sim\Statecraft.Sim.Headless.csproj" />
  </ItemGroup>
</Project>
