<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Unity sim assembly (Assets/Scripts/Sim), compiled as-is against the same API surface
    Unity uses (.NET Standard 2.1). If it builds here it builds in Unity, and vice versa.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Statecraft.Sim</AssemblyName>
    <RootNamespace>Statecraft.Sim</RootNamespace>
    <!-- The XML docs feed Docs/generated/PARAMETERS.md. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(StatecraftAssets)Scripts\Sim\**\*.cs" />
  </ItemGroup>
</Project>
